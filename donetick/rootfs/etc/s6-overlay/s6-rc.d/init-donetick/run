#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant App: DoneTick
# Renders the DoneTick configuration from the app options
# ==============================================================================
declare jwt_secret
declare public_host_line=''

mkdir -p /etc/donetick/config

# Used to build absolute links (e.g. in notifications); optional
if bashio::config.has_value 'public_host'; then
    public_host_line="  public_host: \"$(bashio::config 'public_host')\""
fi

# JWT secret signs login sessions. Use the option if set; otherwise
# generate one on first run and persist it in /data so sessions and
# API tokens survive restarts and updates.
if bashio::config.has_value 'jwt_secret'; then
    jwt_secret=$(bashio::config 'jwt_secret')
elif bashio::fs.file_exists '/data/.jwt_secret'; then
    jwt_secret=$(</data/.jwt_secret)
else
    bashio::log.info 'Generating a JWT signing secret (kept in /data)...'
    jwt_secret=$(openssl rand -hex 32)
    echo "${jwt_secret}" > /data/.jwt_secret
    chmod 600 /data/.jwt_secret
fi

cat > /etc/donetick/config/selfhosted.yaml <<EOF
# Generated by the Home Assistant app from its options — do not edit here.
name: "selfhosted"
is_done_tick_dot_com: false
is_user_creation_disabled: $(bashio::config 'disable_signups')

database:
  type: "sqlite"
  migration: true

jwt:
  secret: "${jwt_secret}"
  session_time: 168h
  max_refresh: 1440h

server:
${public_host_line}
  port: 2021
  read_timeout: 10s
  write_timeout: 10s
  rate_period: 60s
  rate_limit: 300
  serve_frontend: true
  cors_allow_origins:
    - "http://localhost:5173"
    - "http://localhost:7926"
    - "https://localhost"
    - "http://localhost"
    - "capacitor://localhost"

logging:
  level: "$(bashio::config 'log_level' 'info')"
  encoding: "console"
  development: false

scheduler_jobs:
  due_job: 30m
  overdue_job: 3h
  pre_due_job: 3h

realtime:
  enabled: true
  sse_enabled: true
EOF

if bashio::config.has_value 'telegram_token'; then
    {
        echo 'telegram:'
        echo "  token: \"$(bashio::config 'telegram_token')\""
    } >> /etc/donetick/config/selfhosted.yaml
fi

if bashio::config.has_value 'pushover_token'; then
    {
        echo 'pushover:'
        echo "  token: \"$(bashio::config 'pushover_token')\""
    } >> /etc/donetick/config/selfhosted.yaml
fi
