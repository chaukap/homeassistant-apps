#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant App: Prometheus
# Renders the Prometheus configuration from the app options
# ==============================================================================
declare scrape_interval
declare evaluation_interval
declare job
declare target

scrape_interval=$(bashio::config 'scrape_interval' 15)
evaluation_interval=$(bashio::config 'evaluation_interval' 15)

mkdir -p \
    /data/prometheus \
    /config/scrape_configs \
    /config/rules \
    /etc/prometheus

cat > /etc/prometheus/prometheus.yml <<EOF
# Generated by the Home Assistant app from its options — do not edit here.
# Extra scrape jobs and rules belong in this app's config directory
# (scrape_configs/*.yaml and rules/*.yaml) and survive restarts.
global:
  scrape_interval: ${scrape_interval}s
  evaluation_interval: ${evaluation_interval}s

rule_files:
  - /config/rules/*.yaml
  - /config/rules/*.yml

scrape_config_files:
  - /config/scrape_configs/*.yaml
  - /config/scrape_configs/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
EOF

# Scrape Home Assistant through the Supervisor's API proxy, so no
# long-lived access token has to be created and stored in the options.
# Requires the 'prometheus:' integration to be enabled in Home Assistant.
if bashio::config.true 'scrape_homeassistant'; then
    cat >> /etc/prometheus/prometheus.yml <<EOF
  - job_name: homeassistant
    metrics_path: /core/api/prometheus
    authorization:
      credentials: "${SUPERVISOR_TOKEN}"
    static_configs:
      - targets: ["supervisor"]
EOF
fi

for job in $(bashio::config 'scrape_configs|keys'); do
    {
        echo "  - job_name: \"$(bashio::config "scrape_configs[${job}].job_name")\""
        if bashio::config.has_value "scrape_configs[${job}].scrape_interval"; then
            echo "    scrape_interval: $(bashio::config "scrape_configs[${job}].scrape_interval")s"
        fi
        if bashio::config.has_value "scrape_configs[${job}].metrics_path"; then
            echo "    metrics_path: \"$(bashio::config "scrape_configs[${job}].metrics_path")\""
        fi
        if bashio::config.has_value "scrape_configs[${job}].scheme"; then
            echo "    scheme: $(bashio::config "scrape_configs[${job}].scheme")"
        fi
        echo "    static_configs:"
        echo "      - targets:"
        for target in $(bashio::config "scrape_configs[${job}].targets"); do
            echo "          - \"${target}\""
        done
    } >> /etc/prometheus/prometheus.yml
done

promtool check config /etc/prometheus/prometheus.yml \
    || bashio::exit.nok \
        "The generated Prometheus configuration is invalid; check the" \
        "scrape_configs options and any files in scrape_configs/ and rules/"
