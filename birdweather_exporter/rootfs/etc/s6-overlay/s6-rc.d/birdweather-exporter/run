#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant App: BirdWeather Exporter
# Runs the BirdWeather Prometheus exporter
# ==============================================================================
declare -a options

bashio::config.require 'station_token' \
    "A BirdWeather station token is required; find it on your station's page at app.birdweather.com"

# The token goes through the environment so it never appears in a
# process list or the log.
BIRDWEATHER_STATION_TOKEN="$(bashio::config 'station_token')"
export BIRDWEATHER_STATION_TOKEN

options+=(--query-interval "$(bashio::config 'query_interval' '5m')")
options+=(--period "$(bashio::config 'period' 'day')")
options+=(--species-limit "$(bashio::config 'species_limit' 100)")
options+=(--listen-address ":9743")

bashio::log.info 'Starting the BirdWeather exporter...'

exec /usr/bin/birdweather-exporter "${options[@]}"
