#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant App: GoToSocial
# Renders the GoToSocial configuration from the app options and, on first
# run, creates the initial account
# ==============================================================================
declare host
declare port
declare proxy
declare username

bashio::config.require 'host' \
    "The public hostname this instance is served on (e.g. social.example.com)"

host=$(bashio::config 'host')
port=$(bashio::config 'port')

mkdir -p \
    /data/storage \
    /data/certs \
    /etc/gotosocial

cat > /etc/gotosocial/config.yaml <<EOF
# Generated by the Home Assistant app from its options — do not edit here.
host: "${host}"
# Dual-stack wildcard: CloudFront reaches the origin over IPv6, so
# binding only 0.0.0.0 would silently refuse every federation request.
bind-address: "::"
port: ${port}

db-type: "sqlite"
db-address: "/data/database.sqlite"

storage-backend: "local"
storage-local-base-path: "/data/storage"

web-template-base-dir: "/usr/share/gotosocial/web/template"
web-asset-base-dir: "/usr/share/gotosocial/web/assets"

accounts-registration-open: false

log-level: "$(bashio::config 'log_level' 'info')"
EOF

# Usernames live on the account domain while the API is served from the
# host domain; must be decided before first federation and never changed
if bashio::config.has_value 'account_domain'; then
    echo "account-domain: \"$(bashio::config 'account_domain')\"" \
        >> /etc/gotosocial/config.yaml
fi

if bashio::config.true 'letsencrypt'; then
    bashio::config.require 'letsencrypt_email' \
        "Let's Encrypt requires a contact email address"
    {
        echo 'letsencrypt-enabled: true'
        echo 'letsencrypt-port: 80'
        echo 'letsencrypt-cert-dir: "/data/certs"'
        echo "letsencrypt-email-address: \"$(bashio::config 'letsencrypt_email')\""
    } >> /etc/gotosocial/config.yaml
fi

if bashio::config.has_value 'trusted_proxies'; then
    echo 'trusted-proxies:' >> /etc/gotosocial/config.yaml
    for proxy in $(bashio::config 'trusted_proxies'); do
        echo "  - \"${proxy}\"" >> /etc/gotosocial/config.yaml
    done
fi

if bashio::config.has_value 'landing_page_user'; then
    echo "landing-page-user: \"$(bashio::config 'landing_page_user')\"" \
        >> /etc/gotosocial/config.yaml
fi

# Create the initial account once, so the instance is usable straight from
# the app options without a shell. Runs before the server starts; the CLI
# initializes and migrates the database as a side effect.
if bashio::config.has_value 'initial_account_username' \
    && bashio::config.has_value 'initial_account_email' \
    && bashio::config.has_value 'initial_account_password' \
    && ! bashio::fs.file_exists '/data/.initial_account_created'; then

    username=$(bashio::config 'initial_account_username')
    bashio::log.info "Creating initial account '${username}'..."

    if gotosocial --config-path /etc/gotosocial/config.yaml \
            admin account create \
            --username "${username}" \
            --email "$(bashio::config 'initial_account_email')" \
            --password "$(bashio::config 'initial_account_password')" \
        && gotosocial --config-path /etc/gotosocial/config.yaml \
            admin account promote --username "${username}"; then
        touch /data/.initial_account_created
        bashio::log.info "Initial account created and promoted to admin"
    else
        bashio::log.warning \
            "Could not create the initial account; if this is not a fresh" \
            "install the account may already exist. Check the log above."
    fi
fi
